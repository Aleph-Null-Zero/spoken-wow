{
  "name": "spoken-launcher",
  "productName": "Spoken Launcher",
  "version": "0.1.0",
  "description": "Installs and updates Spoken and its voice packs.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Spoken",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yauzl": "^3.4.0"
  },
  "build": {
    "appId": "one.rusty.spoken.launcher",
    "productName": "Spoken Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "artifactName": "Spoken-Launcher-Setup-${version}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/rusty-key/spoken-wow/releases/download/launcher-latest"
      }
    ]
  }
}
