{
  "name": "spoken-launcher",
  "productName": "Spoken Launcher",
  "version": "0.1.0",
  "description": "Installs and updates Spoken and its voice packs.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Spoken",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
